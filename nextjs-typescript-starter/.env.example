# 环境变量示例。复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 本项目直连真实数据库，没有 mock 开关。

# ── 数据库 ────────────────────────────────────────────────────────────────
# Supabase 连接串，必填。本项目沿用 starter 的变量名 POSTGRES_URL
# （danci-admin 用的是 DATABASE_URL，两者指向同一个库）。
# 取值：Supabase 控制台 → Connect → OR 下的连接串，密码替换为数据库密码。
# 走 pooler（6543 端口）时务必保留 ?sslmode=require 或交给驱动处理。
POSTGRES_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# ── 鉴权 ──────────────────────────────────────────────────────────────────
# 必填。本地开发可从 https://generate-secret.vercel.app/32 生成。
AUTH_SECRET="<32+ 位随机字符串>"
